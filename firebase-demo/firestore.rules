rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /scores/{docId} {
      allow read: if true;
      allow create: if validScore()
                    && docId == request.resource.data.game + '_' + request.auth.uid;
      allow update: if validScore()
                    && docId == request.resource.data.game + '_' + request.auth.uid
                    && request.resource.data.uid == resource.data.uid
                    && request.resource.data.game == resource.data.game
                    && request.resource.data.score > resource.data.score;
    }

    function validScore() {
      return request.auth != null
             && request.resource.data.uid == request.auth.uid
             && request.resource.data.keys().hasAll([
               'uid', 'name', 'photoURL', 'game', 'score', 'updatedAt'
             ])
             && request.resource.data.keys().hasOnly([
               'uid', 'name', 'photoURL', 'game', 'score', 'updatedAt'
             ])
             && request.resource.data.name is string
             && request.resource.data.photoURL is string
             && request.resource.data.game in [
               'snake', 'tictactoe', 'block-puzzle'
             ]
             && request.resource.data.score is int
             && request.resource.data.score >= 0
             && request.resource.data.updatedAt is timestamp
             && request.resource.data.updatedAt == request.time;
    }
  }
}
